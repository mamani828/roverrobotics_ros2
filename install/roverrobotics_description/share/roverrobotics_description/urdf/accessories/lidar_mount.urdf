<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_lidar_mount">

  <link name="lidar_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find roverrobotics_description)/meshes/lidar_mount.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find roverrobotics_description)/meshes/lidar_mount.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="lidar_mount_to_payload" type="fixed">
    <parent link="payload_link"/>
    <child link="lidar_mount_link"/>
    <origin xyz="0.04 0 0.183" rpy="0 0 0"/>
  </joint>

</robot>
