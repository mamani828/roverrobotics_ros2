<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_vlp32c">

  <link name="velodyne_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find roverrobotics_description)/meshes/vlp32c.stl"
              scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find roverrobotics_description)/meshes/vlp32c.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.83"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="velodyne_to_mount" type="fixed">
    <parent link="lidar_mount_link"/>
    <child link="velodyne_link"/>
    <origin xyz="0 0 0.028" rpy="0 0 0"/>
  </joint>

</robot>
